  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "jsx": "react-native",
    "moduleResolution": "node",
    "target": "ESNext",
    "skipLibCheck": true
  },
  "include": [
    "./**/*"
  ],
  "extends": "expo/tsconfig.base"
}
